  line((tl.x, tl.y), Q, stroke: 1.1pt + red)
  circle((tl.x, tl.y), radius: 0.018, fill: red, stroke: none)
  circle(P, radius: 0.018, fill: red, stroke: none)
  circle(Q, radius: 0.018, fill: red, stroke: none)
